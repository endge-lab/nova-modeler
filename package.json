{
  "name": "@endge/nova-modeler",
  "type": "module",
  "version": "0.29.15",
  "private": false,
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nova-modeler.js"
    }
  },
  "module": "./dist/nova-modeler.js",
  "types": "./dist/index.d.ts",
  "nova": {
    "components": "./nova-components.json"
  },
  "files": [
    "dist",
    "nova-components.json"
  ],
  "scripts": {
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vite.config.ts --coverage",
    "bench": "vitest run --config vite.bench.config.ts",
    "lint-check": "eslint . --cache",
    "lint-fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@endge/nova": "^0.13.11",
    "@endge/nova-ui-kit": "^0.10.14",
    "@endge/utils": "^0.25.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  }
}
